{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tenancy": {
    "Hosts": {
      "Mode": "Shared",
      "BaseDomain": "teambeats.localhost",
      "PlatformSubdomain": "platform"
    }
  },
  "Messaging": {
    "Transport": "InMemory"
  },
  "Auth": {
    "DevSignIn": {
      "Enabled": false
    }
  },
  "Platform": {
    "Regions": {
      "Offered": [
        "primary"
      ],
      "Default": "primary"
    }
  }
}
