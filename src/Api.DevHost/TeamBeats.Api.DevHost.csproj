<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TeamBeats.Api.DevHost</RootNamespace>
    <AssemblyName>TeamBeats.Api.DevHost</AssemblyName>
  </PropertyGroup>
  <!-- Development/Test composition: the production API plus development sign-in and fake external systems (ADR-0004). -->
  <ItemGroup>
    <ProjectReference Include="../Api/TeamBeats.Api.csproj" />
    <ProjectReference Include="../Modules/Identity.DevAuth/TeamBeats.Modules.Identity.DevAuth.csproj" />
    <ProjectReference Include="../DevFakes/TeamBeats.DevFakes.csproj" />
  </ItemGroup>
  <!-- Fictional scenarios for the fake external systems (docs/testing/fake-systems.md). -->
  <ItemGroup>
    <Content Update="scenarios/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Seed content for the test tenant, such as the staging home (docs/testing/fake-systems.md). -->
    <Content Update="seeds/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The demo data package: bilingual content for every in-app area (docs/testing/demo-data.md). -->
    <Content Update="seeds/demo/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
