{
  "ConnectionStrings": {
    "App": "Host=localhost;Port=5432;Database=teambeats;Username=tb_app;Password=tb_app_dev_only",
    "Owner": "Host=localhost;Port=5432;Database=teambeats;Username=tb_owner;Password=tb_owner_dev_only"
  },
  "Auth": {
    "DevSignIn": {
      "Enabled": true
    }
  },
  "Dev": {
    "MigrateOnStart": true,
    "SeedFile": "../../deploy/compose/seed/dev-users.json",
    "SeedDemo": {
      "Folder": "seeds/demo"
    },
    "Fakes": {
      "Enabled": true,
      "Scenario": "scenarios/staging-demo.json",
      "RunDirectorySync": true
    },
    "SeedTenant": {
      "Key": "demo",
      "DisplayName": "TeamBeats Demo",
      "PackageKey": "enterprise_gov",
      "DefaultLocale": "en",
      "EnabledLocales": [ "ar", "en" ],
      "TimeZone": "Asia/Dubai",
      "Admins": [ "admin@demo.example" ]
    }
  },
  "Storage": {
    "Root": "../../.storage"
  },
  "Notifications": {
    "Email": { "Mode": "Capture" },
    "Delivery": { "InProcess": true }
  },
  "Workflow": {
    "Jobs": { "InProcess": true }
  },
  "Content": {
    "Schedule": { "InProcess": true }
  },
  "Documents": {
    "Maintenance": { "InProcess": true }
  },
  "Policies": {
    "Maintenance": { "InProcess": true }
  },
  "Search": {
    "Bootstrap": { "InProcess": true }
  },
  "Messaging": {
    "Outbox": { "InProcess": true }
  }
}
