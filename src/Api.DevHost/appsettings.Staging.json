{
  "Http": {
    "TrustForwardedHeaders": true
  },
  "Auth": {
    "DevSignIn": {
      "Enabled": true,
      "Mode": "TestAccount",
      "TestAccounts": [
        {
          "Username": "admin",
          "Email": "admin@staging.example",
          "DisplayName": "Staging Test Admin",
          "Next": "/api/v1/me/outlook/connect?silent=true&returnTo=%2F"
        }
      ]
    }
  },
  "Tenancy": {
    "Hosts": {
      "Mode": "Dedicated",
      "DedicatedTenantKey": "staging-demo"
    }
  },
  "Dev": {
    "MigrateOnStart": true,
    "Fakes": {
      "Enabled": true,
      "Scenario": "scenarios/staging-demo.json",
      "RunDirectorySync": true,
      "SignInLinks": {
        "employee": "ahmed.mansour@staging.example"
      }
    },
    "SeedHome": {
      "File": "seeds/staging-home.json"
    },
    "SeedDemo": {
      "Folder": "seeds/demo"
    },
    "SeedTenant": {
      "Key": "staging-demo",
      "DisplayName": "TeamBeats Staging",
      "PackageKey": "enterprise_gov",
      "DefaultLocale": "en",
      "EnabledLocales": [ "ar", "en" ],
      "TimeZone": "Asia/Dubai",
      "Admins": [ "admin@staging.example" ]
    }
  },
  "Notifications": {
    "Email": { "Mode": "Capture" },
    "Delivery": { "InProcess": true }
  }
}
