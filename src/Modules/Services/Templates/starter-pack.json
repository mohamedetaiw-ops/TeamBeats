[
  {
    "key": "business_cards",
    "version": 1,
    "icon": "user",
    "names": {
      "en": "Business cards",
      "ar": "بطاقات العمل"
    },
    "descriptions": {
      "en": "Order printed business cards with your details from the directory.",
      "ar": "اطلب بطاقات عمل مطبوعة ببياناتك من الدليل."
    },
    "classification": "internal",
    "form": {
      "fields": [
        {
          "key": "full_name",
          "type": "text",
          "labels": {
            "en": "Name on the card",
            "ar": "الاسم على البطاقة"
          },
          "required": true,
          "prefill": "profile.display_name"
        },
        {
          "key": "job_title",
          "type": "text",
          "labels": {
            "en": "Job title",
            "ar": "المسمى الوظيفي"
          },
          "required": true,
          "prefill": "profile.job_title"
        },
        {
          "key": "email",
          "type": "text",
          "labels": {
            "en": "Email",
            "ar": "البريد الإلكتروني"
          },
          "required": true,
          "prefill": "profile.email"
        },
        {
          "key": "extension",
          "type": "text",
          "labels": {
            "en": "Extension",
            "ar": "التحويلة"
          },
          "prefill": "profile.work_phone"
        },
        {
          "key": "include_mobile",
          "type": "choice",
          "labels": {
            "en": "Include my mobile number",
            "ar": "إضافة رقم الجوال"
          },
          "required": true,
          "options": [
            {
              "value": "yes",
              "labels": {
                "en": "Yes",
                "ar": "نعم"
              }
            },
            {
              "value": "no",
              "labels": {
                "en": "No",
                "ar": "لا"
              }
            }
          ]
        },
        {
          "key": "mobile",
          "type": "text",
          "labels": {
            "en": "Mobile number",
            "ar": "رقم الجوال"
          },
          "prefill": "profile.mobile_phone",
          "showWhen": {
            "field": "include_mobile",
            "values": [
              "yes"
            ]
          }
        },
        {
          "key": "boxes",
          "type": "number",
          "labels": {
            "en": "Number of boxes",
            "ar": "عدد العلب"
          },
          "required": true,
          "rules": [
            {
              "kind": "min",
              "value": 1
            },
            {
              "kind": "max",
              "value": 10
            }
          ]
        }
      ]
    },
    "route": {
      "graph": {
        "steps": [
          {
            "id": "manager",
            "type": "approval",
            "names": {
              "en": "Line manager approval",
              "ar": "موافقة المدير المباشر"
            },
            "assignee": {
              "kind": "line_manager"
            },
            "dueWorkingDays": 3
          },
          {
            "id": "print",
            "type": "task",
            "names": {
              "en": "Print the cards",
              "ar": "طباعة البطاقات"
            },
            "assignee": {
              "kind": "permission_at_unit",
              "permission": "service.manage"
            },
            "dueWorkingDays": 5
          },
          {
            "id": "done",
            "type": "end",
            "result": "completed"
          }
        ],
        "links": [
          {
            "from": "manager",
            "to": "print"
          },
          {
            "from": "print",
            "to": "done"
          }
        ]
      },
      "continueAfterExit": false,
      "serviceLevelDays": 10
    },
    "allowOnBehalf": false,
    "maxAttachments": 0
  },
